{
  "expo": {
    "name": "TransportApp",
    "slug": "TransportApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nibm.transportapp",
      "config": {
        "googleMapsApiKey": "AIzaSyCm95_zVsHVhzfIwTAqPtCnmuJeIRF9LNo"
      }
    },
    "android": {
      "package": "com.nibm.transportapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCm95_zVsHVhzfIwTAqPtCnmuJeIRF9LNo"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-barcode-scanner",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow TransportApp to use your location for navigation."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TransportApp to use your camera to scan QR codes."
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}

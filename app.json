{
  "expo": {
    "name": "TransportApp",
    "slug": "TransportApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nibm.transportapp"
    },
    "android": {
      "package": "com.nibm.transportapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow TransportApp to use your location for navigation."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TransportApp to use your camera to scan QR codes."
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      ["expo-notifications", { "color": "#1D4ED8" }]
    ],
    "extra": {
      "eas": {
        "projectId": "33b59a62-f8b3-469e-a447-177c59ad04a8"
      }
    }
  }
}
